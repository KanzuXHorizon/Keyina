{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keyina.dev/schemas/benchmark-result-v2.json",
  "title": "Keyina benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "cases", "checksum"],
  "properties": {
    "schema_version": {"const": 2},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "processor",
        "compiler",
        "build_type",
        "warmup_iterations",
        "measured_iterations"
      ],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "processor": {"type": "string", "minLength": 1},
        "compiler": {"type": "string", "minLength": 1},
        "build_type": {"enum": ["debug", "release"]},
        "warmup_iterations": {"type": "integer", "minimum": 1},
        "measured_iterations": {"type": "integer", "minimum": 1}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "median_ns",
          "p95_ns",
          "p99_ns",
          "max_ns",
          "allocations_per_operation",
          "allocation_budget",
          "budget_pass"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "median_ns": {"type": "number", "minimum": 0},
          "p95_ns": {"type": "number", "minimum": 0},
          "p99_ns": {"type": "number", "minimum": 0},
          "max_ns": {"type": "number", "minimum": 0},
          "allocations_per_operation": {"type": "number", "minimum": 0},
          "allocation_budget": {"type": "number", "minimum": 0},
          "budget_pass": {"type": "boolean"}
        }
      }
    },
    "checksum": {"type": "integer", "minimum": 0}
  }
}
