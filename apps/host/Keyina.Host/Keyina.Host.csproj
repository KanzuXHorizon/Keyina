<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Keyina.Host</RootNamespace>
    <AssemblyName>Keyina.Host</AssemblyName>
    <Description>Resident Windows host for Keyina tray, hotkeys, snippets, and speech.</Description>
    <ApplicationIcon>..\..\..\brand\generated\keyina.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <KeyinaRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..'))</KeyinaRepoRoot>
    <KeyinaNativePreset Condition="'$(Configuration)' == 'Release'">windows-msvc-release</KeyinaNativePreset>
    <KeyinaNativePreset Condition="'$(KeyinaNativePreset)' == ''">windows-msvc-debug</KeyinaNativePreset>
    <KeyinaNativeConfiguration Condition="'$(Configuration)' == 'Release'">Release</KeyinaNativeConfiguration>
    <KeyinaNativeConfiguration Condition="'$(KeyinaNativeConfiguration)' == ''">Debug</KeyinaNativeConfiguration>
    <KeyinaNativeEnginePath>$(KeyinaRepoRoot)\build\$(KeyinaNativePreset)\platform\windows\hook\$(KeyinaNativeConfiguration)\KeyinaEngine.dll</KeyinaNativeEnginePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Keyina.Host.Core\Keyina.Host.Core.csproj" />
    <ProjectReference Include="..\Keyina.Host.Windows\Keyina.Host.Windows.csproj" />
    <ProjectReference Include="..\Keyina.Speechmatics\Keyina.Speechmatics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\brand\generated\keyina-tray-active.ico"
             Link="Assets\keyina-tray-active.ico"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\brand\generated\keyina-tray-inactive.ico"
             Link="Assets\keyina-tray-inactive.ico"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\brand\generated\keyina-tray-listening.ico"
             Link="Assets\keyina-tray-listening.ico"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyKeyinaNativeEngineToPublish" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT' and '$(PublishDir)' != ''">
    <Error Condition="!Exists('$(KeyinaNativeEnginePath)')" Text="KeyinaEngine.dll was not built at $(KeyinaNativeEnginePath)." />
    <Copy SourceFiles="$(KeyinaNativeEnginePath)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
